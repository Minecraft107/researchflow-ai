# Copy this file to .env and fill in the keys. Never commit .env.
# Keep comments on their own lines (not after a value).

# Required: Claude API key - https://console.anthropic.com
ANTHROPIC_API_KEY=
# Required for the default search provider - https://tavily.com
TAVILY_API_KEY=
# Optional alternative search provider - https://brave.com/search/api
BRAVE_API_KEY=

# tavily | brave
SEARCH_PROVIDER=tavily

# Model for planning, critique, writing and the citation audit
CLAUDE_MODEL=claude-opus-5-5
# Model for evidence extraction (most calls). Empty = same as CLAUDE_MODEL.
# A cheaper model here (e.g. claude-haiku-5-5) is the biggest cost lever.
CLAUDE_EXTRACTION_MODEL=
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# Critic loop
QUALITY_THRESHOLD=80
MAX_CRITIQUE_ITERATIONS=3

# Cost controls
MAX_SEARCH_QUERIES=36
MAX_RESULTS_PER_QUERY=6
MAX_PAGE_CHARS=12000
CACHE_TTL_SECONDS=86400

# API hardening
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_RUNS=3
CORS_ORIGINS=http://localhost:5173

# Some sites (e.g. Wikipedia) only serve bots that give a contact URL or email:
# FETCH_USER_AGENT=MyOrgResearch/1.0 (+https://example.org/bot)

# Default is SQLite in backend/researchflow.db. For PostgreSQL (pip install psycopg):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/researchflow

LOG_LEVEL=INFO
